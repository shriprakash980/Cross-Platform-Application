# =============================================================================
# HB+ AEGIS - ENVIRONMENT CONFIGURATION
# =============================================================================
# All client-accessible variables must start with EXPO_PUBLIC_
# =============================================================================

# Domain restriction policy (Strictly enforced)
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit

# Firebase Web App Configuration
# Obtain these values from your Firebase Project Console -> Project Settings -> General
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyExamplePlaceholderKey1234567890
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hbplus-aegis.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hbplus-aegis
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=hbplus-aegis.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Google OAuth 2.0 Client IDs (For native iOS/Android expo-auth-session support)
# Web Client ID from Google Cloud Console / Firebase Authentication
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
# iOS Client ID from Google Cloud Console (Optional for web)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789012-iosclientidexample.apps.googleusercontent.com
# Android Client ID from Google Cloud Console (Optional for web)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=123456789012-androidclientidexample.apps.googleusercontent.com
